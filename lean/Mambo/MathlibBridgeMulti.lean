import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.Ideal.Span

/-!
# Mambo — Mathlib Bridge, Multi-Variable

Extends `Mambo.MathlibBridge` to the multi-variable case using mathlib's
`MvPolynomial`. Pins the semantic content of Step B.1 for `n` independent
Boolean residual variables.

For each variable `X_i` (i ∈ Fin n), the Boolean polynomial
`X_i · (X_i − 1)` generates a relation in the multi-variable ideal.
Equivalently `X_i² ≡ X_i (mod I)` for each i.

This is the typed form of the assertion "n independent Boolean residuals
contribute HS factor (1+z)^n" — at this stage we prove the IDEAL
MEMBERSHIP for each variable's Boolean reduction. The full
"quotient has dimension 2^n" corollary requires `Module.rank` and tensor
machinery, deferred.
-/

namespace Mambo.MathlibBridge.Multi

open MvPolynomial

variable {K : Type*} [CommRing K] {n : ℕ}

/-- The Boolean polynomial for variable `X_i`: `X_i² − X_i`
    (equivalent to `X_i · (X_i − 1)` over any commutative ring). -/
noncomputable def booleanPolyMv (i : Fin n) : MvPolynomial (Fin n) K :=
  let x : MvPolynomial (Fin n) K := X i
  x * x - x

/-- The Boolean ideal: generated by all `n` Boolean polynomials
    `{ X_i · (X_i − 1) | i ∈ Fin n }`. -/
noncomputable def booleanIdealMv : Ideal (MvPolynomial (Fin n) K) :=
  Ideal.span (Set.range (booleanPolyMv : Fin n → MvPolynomial (Fin n) K))

/-- Each Boolean polynomial is a generator of the Boolean ideal. -/
theorem booleanPolyMv_mem (i : Fin n) :
    booleanPolyMv i ∈ (booleanIdealMv : Ideal (MvPolynomial (Fin n) K)) :=
  Ideal.subset_span (Set.mem_range_self _)

/-- **Multi-variable Boolean reduction (fully proven in mathlib types):**
    for every variable `X_i`, `X_i² ≡ X_i (mod I)`. Equivalently:
    `X_i² − X_i ∈ booleanIdealMv` for every `i ∈ Fin n`.

    This is the semantic form of Step B.1's "n independent Boolean
    residuals" claim, formally typed against mathlib's `MvPolynomial`
    and `Ideal`. -/
theorem boolean_X_squared_reduces_mv (i : Fin n) :
    (X i : MvPolynomial (Fin n) K)^2 - (X i : MvPolynomial (Fin n) K)
      ∈ (booleanIdealMv : Ideal (MvPolynomial (Fin n) K)) := by
  have h : (X i : MvPolynomial (Fin n) K)^2 - (X i : MvPolynomial (Fin n) K)
        = booleanPolyMv (K := K) i := by
    unfold booleanPolyMv
    ring
  rw [h]
  exact booleanPolyMv_mem i

/-- For each variable `X_i` and every `k ≥ 1`,
    `X_i^(k+1) − X_i ∈ booleanIdealMv`. Mirror of the single-variable
    `X_pow_succ_minus_X_mem` lemma at multi-variable.

    Proof by induction on `k`:
    - Base (k = 0): `X_i^1 − X_i = 0 ∈ I`.
    - Step: `X_i^(k+2) − X_i = X_i · (X_i^(k+1) − X_i) + (X_i² − X_i)`,
      both summands in I. -/
theorem X_pow_succ_minus_X_mem_mv (i : Fin n) :
    ∀ k : ℕ,
      (X i : MvPolynomial (Fin n) K)^(k+1) - (X i : MvPolynomial (Fin n) K)
        ∈ (booleanIdealMv : Ideal (MvPolynomial (Fin n) K))
  | 0 => by simp
  | k + 1 => by
      have h_id : (X i : MvPolynomial (Fin n) K)^(k+2)
                  - (X i : MvPolynomial (Fin n) K)
                = (X i : MvPolynomial (Fin n) K)
                  * ((X i : MvPolynomial (Fin n) K)^(k+1)
                     - (X i : MvPolynomial (Fin n) K))
                  + ((X i : MvPolynomial (Fin n) K)^2
                     - (X i : MvPolynomial (Fin n) K)) := by ring
      rw [h_id]
      exact Ideal.add_mem _
        (Ideal.mul_mem_left _ _ (X_pow_succ_minus_X_mem_mv i k))
        (boolean_X_squared_reduces_mv i)

end Mambo.MathlibBridge.Multi
