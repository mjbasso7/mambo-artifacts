import Mathlib.Algebra.Polynomial.Basic
import Mathlib.RingTheory.Ideal.Span
import Mambo.MathlibBridgeDim

/-!
# Mambo — Mathlib Bridge

Bridges the Nat-based Lean modules to mathlib's univariate `Polynomial`
and `Ideal` types. Pins the **semantic content** of the Boolean reduction
lemma (B.1) at the type level using actual ring/ideal infrastructure.

A Boolean residual variable corresponds to a polynomial `X · (X − 1)`
whose ideal generates a 2-dimensional quotient over the base field K.
This file proves the core ideal-membership fact: `X² − X ∈ (X · (X − 1))`.
The dimension `2 = 2^1` claim is `booleanIdeal_quot_finrank` below,
linking to `Mambo.MathlibBridge.Dim.boolQuot_finrank`.
-/

namespace Mambo.MathlibBridge

open Polynomial

variable {K : Type*} [CommRing K]

/-- The Boolean defining polynomial: `X · (X − 1)`. Expanded: `X² − X`. -/
noncomputable def booleanPoly : Polynomial K := X * (X - 1)

/-- The ideal `(X · (X − 1))` in `K[X]`. The corresponding quotient
    `K[X] / I` is two-dimensional over `K`, generated by the residues
    of `1` and `X`. -/
noncomputable def booleanIdeal : Ideal (Polynomial K) :=
  Ideal.span {booleanPoly}

/-- **Generator membership:** the Boolean polynomial lies in the ideal it
    generates. (Trivial via `Ideal.subset_span`.) -/
theorem booleanPoly_mem_booleanIdeal :
    booleanPoly ∈ (booleanIdeal : Ideal (Polynomial K)) :=
  Ideal.subset_span (Set.mem_singleton _)

/-- **Boolean reduction (semantic, fully proven in mathlib types):**
    `X² ≡ X` modulo the Boolean ideal. Concretely: `X² − X ∈ I`.

    This is the semantic content of Step B.1 at one Boolean variable —
    moved from `True`-placeholder in `Mambo.BooleanReduction` to a real
    typed proof against mathlib's `Polynomial` and `Ideal`. -/
theorem boolean_X_squared_reduces :
    (X^2 - X : Polynomial K) ∈ (booleanIdeal : Ideal (Polynomial K)) := by
  have h : (X^2 - X : Polynomial K) = booleanPoly := by
    unfold booleanPoly
    ring
  rw [h]
  exact booleanPoly_mem_booleanIdeal

/-- Equivalent statement using `X * (X - 1)` directly. -/
theorem boolean_factored_mem :
    (X * (X - 1) : Polynomial K) ∈ (booleanIdeal : Ideal (Polynomial K)) :=
  booleanPoly_mem_booleanIdeal

/-- **Generalized Boolean reduction:** for every positive natural number `k`,
    `X^(k+1) − X ∈ booleanIdeal`. Equivalently, `X^(k+1) ≡ X (mod I)` for
    all `k ≥ 1` — the Boolean property holds at all higher powers, not
    just `X² ≡ X`.

    Proof by induction on `k`:
    - Base (k = 1): `X^2 − X = booleanPoly ∈ I` (already proven above).
    - Step: `X^(k+2) − X = X · (X^(k+1) − X) + (X² − X)`, both summands in I.
-/
theorem X_pow_succ_minus_X_mem :
    ∀ k : ℕ, (X^(k+1) - X : Polynomial K) ∈ (booleanIdeal : Ideal (Polynomial K))
  | 0 => by
      -- X^1 - X = 0 ∈ I
      simp
  | k + 1 => by
      -- Goal: X^(k+2) - X ∈ I
      -- Use the algebraic identity X^(k+2) - X = X * (X^(k+1) - X) + (X^2 - X)
      have h_id : (X^(k+2) - X : Polynomial K)
                = X * (X^(k+1) - X) + (X^2 - X) := by ring
      rw [h_id]
      exact Ideal.add_mem _
        (Ideal.mul_mem_left _ X (X_pow_succ_minus_X_mem k))
        boolean_X_squared_reduces

/-- **Single-variable Boolean-quotient dimension (closes the docstring's
    "deferred" gap):** `Polynomial K / booleanIdeal` has K-finrank 2.

    The two `booleanPoly` formulations coincide: `X · (X − 1) = X² − X`,
    so `booleanIdeal = Ideal.span {X² − X}`. By definition,
    `AdjoinRoot f = Polynomial K / Ideal.span {f}`, so the two quotient
    rings are definitionally equal. The dim = 2 result transfers via
    `Mambo.MathlibBridge.Dim.boolQuot_finrank`. -/
theorem booleanIdeal_quot_finrank (K : Type*) [Field K] :
    Module.finrank K (Polynomial K ⧸ (booleanIdeal : Ideal (Polynomial K))) = 2 := by
  have h_eq : (booleanIdeal : Ideal (Polynomial K))
            = Ideal.span {Mambo.MathlibBridge.Dim.boolPoly K} := by
    unfold booleanIdeal booleanPoly Mambo.MathlibBridge.Dim.boolPoly
    congr 1
    ext y
    constructor <;> rintro h <;> simp only [Set.mem_singleton_iff] at h ⊢
    · rw [h]; ring
    · rw [h]; ring
  rw [h_eq]
  -- `Polynomial K / Ideal.span {boolPoly}` defeq `AdjoinRoot (boolPoly)`.
  exact Mambo.MathlibBridge.Dim.boolQuot_finrank K

end Mambo.MathlibBridge
