import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.Ideal.Span

/-!
# Mambo — Step B.2 Variable Enumeration (Lean formalization)

Formalizes Step B.2 of the universal-Q framework: the enumeration
of variables and constraint count in the Mambo polynomial ring `R/I`
at width `t` and depth `n`.

**Claim (informal, B.2 lemma):** For Mambo at width `t`, depth `n`:
- The polynomial ring `R` has `t·(n+1)` state variables `s_{c,r}`
  for `c ∈ Fin t` (cell index) and `r ∈ Fin (n+1)` (round index).
- The ideal `I` is generated by `t·n` round-constraint polynomials
  (one per (cell, round) edge) **plus** 2 boundary linear constraints
  (`s_{0,0} = 0` at one end, `s_{0,n} = target` at the other).
- Total generator count: `t·n + 2`.

This file pins these counts as decidable theorems via Lean's type-level
arithmetic, and provides typed-skeleton definitions for the index types
and constraint enumeration. The constraint polynomials themselves
(quadratic coupled chain) are encoded in `Mambo.RoundFunction`; this
file accounts for them at the cardinality level.
-/

namespace Mambo.B2Enumeration

/-- Polynomial-ring index type at width `t`, depth `n`: each state
    variable is indexed by a (cell, round) pair. -/
abbrev VarIndex (t n : Nat) := Fin t × Fin (n + 1)

/-- Total state-variable count at width `t`, depth `n`: `t·(n+1)`. -/
def numStateVars (t n : Nat) : Nat := t * (n + 1)

/-- The variable index space has cardinality `t·(n+1)`. -/
theorem card_VarIndex (t n : Nat) :
    Fintype.card (VarIndex t n) = numStateVars t n := by
  show Fintype.card (Fin t × Fin (n + 1)) = t * (n + 1)
  rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]

/-- Index type for round-constraint generators: each is a (cell, round)
    edge from `(c, r)` to `(c, r+1)`. There are `t·n` such edges. -/
abbrev ConstraintIndex (t n : Nat) := Fin t × Fin n

/-- Round-constraint count: `t·n`. -/
def numRoundConstraints (t n : Nat) : Nat := t * n

/-- Constraint-index space has the predicted cardinality. -/
theorem card_ConstraintIndex (t n : Nat) :
    Fintype.card (ConstraintIndex t n) = numRoundConstraints t n := by
  show Fintype.card (Fin t × Fin n) = t * n
  rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]

/-- Boundary linear constraint count: 2 (one at each end of the chain). -/
def numBoundaryConstraints : Nat := 2

/-- Total ideal-generator count: `t·n + 2`. -/
def numIdealGenerators (t n : Nat) : Nat :=
  numRoundConstraints t n + numBoundaryConstraints

/-- **Anchor (t=4, n=3):** 16 state variables, 12 round constraints, 14 total generators. -/
example : numStateVars 4 3 = 16 := by decide
example : numRoundConstraints 4 3 = 12 := by decide
example : numIdealGenerators 4 3 = 14 := by decide

/-- **Anchor (t=4, n=4):** 20 state variables, 16 round constraints, 18 total generators. -/
example : numStateVars 4 4 = 20 := by decide
example : numRoundConstraints 4 4 = 16 := by decide
example : numIdealGenerators 4 4 = 18 := by decide

/-- **Anchor (t=6, n=4):** 30 state variables, 24 round constraints, 26 total generators. -/
example : numStateVars 6 4 = 30 := by decide
example : numRoundConstraints 6 4 = 24 := by decide
example : numIdealGenerators 6 4 = 26 := by decide

/-- **Anchor (t=8, n=4):** 40 state variables, 32 round constraints, 34 total generators. -/
example : numStateVars 8 4 = 40 := by decide
example : numRoundConstraints 8 4 = 32 := by decide
example : numIdealGenerators 8 4 = 34 := by decide

/-- The relationship `numStateVars − numIdealGenerators = t − 2` for t ≥ 2 n ≥ 1
    (i.e. the "leftover" variable count, before any reductions). -/
theorem dim_count_relation (t n : Nat) (ht : 2 ≤ t) (_hn : 1 ≤ n) :
    numStateVars t n = numIdealGenerators t n + (t - 2) := by
  unfold numStateVars numIdealGenerators numRoundConstraints numBoundaryConstraints
  -- t*(n+1) = t*n + 2 + (t - 2), given t ≥ 2 n ≥ 1
  have : t * (n + 1) = t * n + t := Nat.mul_succ t n
  omega

/-- Anchor: at t=4, the "leftover" before reduction is 4 - 2 = 2 (matches B.2's
    constraint algebra count). -/
example : numStateVars 4 3 - numIdealGenerators 4 3 = 2 := by decide
example : numStateVars 4 4 - numIdealGenerators 4 4 = 2 := by decide

/-- The full Mambo polynomial ring at (t, n) is `K[s_{c,r}]_{(c,r) ∈ VarIndex t n}`,
    isomorphic to `MvPolynomial (VarIndex t n) K`. -/
abbrev MamboRing (K : Type*) [CommRing K] (t n : Nat) :=
  MvPolynomial (VarIndex t n) K

/-- The variable count of `MamboRing K t n` matches `numStateVars t n`. -/
theorem MamboRing_var_count (K : Type*) [CommRing K] (t n : Nat) :
    Fintype.card (VarIndex t n) = numStateVars t n :=
  card_VarIndex t n

end Mambo.B2Enumeration
